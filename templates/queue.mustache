{{!
    @template block_gradingqueue/queue

    Work waiting for grading, oldest first.

    Example context (json):
    {
        "hasrows": true,
        "rows": [{"url": "#", "name": "Essay 1", "coursename": "Biology", "showcourse": true,
                  "waiting": "3 waiting", "oldest": "Waiting since 2/11/26, 09:00", "icon": ""}]
    }
}}
{{#hasrows}}
<ul class="list-unstyled mb-0 block-gradingqueue-list">
    {{#rows}}
    <li class="mb-2 d-flex">
        <span class="me-2">{{{icon}}}</span>
        <span>
            <a href="{{url}}">{{name}}</a> <span class="badge bg-primary text-white">{{waiting}}</span>
            <span class="d-block small text-muted">{{#showcourse}}{{coursename}} &middot; {{/showcourse}}{{oldest}}</span>
        </span>
    </li>
    {{/rows}}
</ul>
{{/hasrows}}
{{^hasrows}}
<p class="mb-0">{{#str}}empty, block_gradingqueue{{/str}}</p>
{{/hasrows}}
