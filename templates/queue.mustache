{{!
    @template block_gradingqueue/queue

    Work waiting for grading, oldest first.

    Example context (json):
    {
        "summary": "6 to grade in 2 courses",
        "hasrows": true,
        "rows": [{"url": "#", "name": "Essay 1", "type": "Assignment", "coursename": "Biology", "showcourse": true,
                  "waiting": "3 waiting", "age": "Oldest 9 days", "since": "27/10/26, 09:00", "overdue": true,
                  "purpose": "assessment", "icon": ""}]
    }
}}
{{#hasrows}}
<p class="block-gradingqueue-summary mb-2">{{summary}}</p>
<ul class="list-unstyled mb-0 block-gradingqueue-list">
    {{#rows}}
    <li class="block-gradingqueue-item">
        <div class="activityiconcontainer smaller {{purpose}} flex-shrink-0" title="{{type}}">{{{icon}}}</div>
        <div class="block-gradingqueue-main">
            <a href="{{url}}" class="block-gradingqueue-name">{{name}}</a>
            <div class="small text-muted">
                {{#showcourse}}<span>{{coursename}}</span> &middot; {{/showcourse}}<span class="{{#overdue}}block-gradingqueue-overdue{{/overdue}}" title="{{since}}">{{age}}{{#overdue}}<span class="visually-hidden"> ({{#str}}overdue, block_gradingqueue{{/str}})</span>{{/overdue}}</span>
            </div>
        </div>
        <span class="badge rounded-pill bg-primary text-white block-gradingqueue-count">{{waiting}}</span>
    </li>
    {{/rows}}
</ul>
{{/hasrows}}
{{^hasrows}}
<div class="block-gradingqueue-empty text-center text-muted py-3">
    {{#pix}} i/checked, core {{/pix}}
    <p class="mb-0">{{#str}}empty, block_gradingqueue{{/str}}</p>
</div>
{{/hasrows}}
